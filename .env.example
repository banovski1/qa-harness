# The only file in this repo anyone writes by hand.
#
#   cp .env.example .env     then fill it in.
#
# One app per checkout. Everything else — analysis.json at the root, and the project
# under generated-framework/ — is produced from this file plus the running app.
# To work on a second app, make a second worktree (the `app-worktree` skill does it
# for you); do not add a second config here.
#
# .env is gitignored. .env.example is committed, and must never contain a real password.

# ─── The app ────────────────────────────────────────────────────────────────────
# A human name. Shows up in reports; nothing depends on its spelling.
APP_NAME=OrangeHRM (open-source demo)

# Where the running app lives. Every crawled URL resolves against this, and a URL
# outside it counts as leaving the application.
APP_BASE_URL=https://opensource-demo.orangehrmlive.com/

# Where the source is checked out on this machine. The analysis skills read it for
# declared routes, entities and API endpoints. `~` is expanded.
APP_REPO_PATH=~/Projects/orangehrm

# The browser session playwright-cli keeps between commands. Any short string.
APP_SESSION=ohrm

# ─── Credentials ────────────────────────────────────────────────────────────────
# Read by the crawlers, by verify-auth.ts, and by the generated tests. Never commit
# real values: fill these in .env only.
APP_USERNAME=
APP_PASSWORD=

# ─── How a test logs in ─────────────────────────────────────────────────────────
# Leave AUTH_LOGIN_URL empty if the app needs no login for what you crawl.
AUTH_LOGIN_URL=https://opensource-demo.orangehrmlive.com/web/index.php/auth/login
AUTH_USERNAME_SELECTOR=input[name='username']
AUTH_PASSWORD_SELECTOR=input[name='password']
AUTH_SUBMIT_SELECTOR=button[type='submit']
# Something that exists ONLY once login succeeded. Pick something you can SEE — a
# container with zero height proves nothing, and the crawl will report a successful
# login it never made.
AUTH_READY_WHEN=.oxd-topbar-header

# ─── The crawl ──────────────────────────────────────────────────────────────────
# Where the deep crawl starts: one per area you care about. These are the doors,
# not the whole building. Comma-separated.
CRAWL_SEED_ROUTES=/web/index.php/dashboard/index,/web/index.php/pim/viewEmployeeList,/web/index.php/pim/addEmployee,/web/index.php/admin/viewSystemUsers,/web/index.php/leave/viewLeaveList,/web/index.php/time/viewEmployeeTimesheet,/web/index.php/recruitment/viewCandidates,/web/index.php/performance/searchEvaluatePerformanceReview,/web/index.php/directory/viewDirectory,/web/index.php/claim/viewAssignClaim,/web/index.php/buzz/viewBuzz

# Never visited. `logout` is here for the obvious reason: one click ends the session
# and every screen after it is the login page. Comma-separated.
CRAWL_EXCLUDE=logout,/web/index.php/admin/viewSystemUsers\?

# Stop after this many screens. Raise it once you have seen a crawl finish.
CRAWL_MAX_SCREENS=40
# How far to follow links from a seed. 2 is usually right; 3 explodes.
CRAWL_MAX_DEPTH=2

# ─── Crawler tuning ─────────────────────────────────────────────────────────────
# The attribute your app uses for test ids, if it has one.
TEST_ID_ATTRIBUTE=data-testid
# The element wrapping the page body, used to tell "still loading" from "empty".
CONTENT_SELECTOR=.oxd-layout-context
BATCH_SIZE=6
SETTLE_TIMEOUT=8000
NAV_TIMEOUT=30000

# The menu map's own budget (map.mjs), separate from the deep crawl's.
CRAWL_MAP_MINUTES=8
CRAWL_MAX_SCREENS_PER_MODULE=8

# Extra paths to probe for an OpenAPI document, beyond the well-known ones.
API_SPEC_CANDIDATES=
