{
  "name": "qa-harness",
  "version": "1.0.0",
  "private": true,
  "description": "Point it at a web app - its source and a running instance - and get a Playwright framework whose page objects contain no locators at all.",
  "keywords": [
    "playwright",
    "test-automation",
    "page-object",
    "codegen",
    "qa",
    "end-to-end",
    "claude-code",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "author": "Tsvetomir Banovski",
  "homepage": "https://github.com/bklv1/qa-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bklv1/qa-harness.git"
  },
  "bugs": {
    "url": "https://github.com/bklv1/qa-harness/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "codex:sync": "node scripts/sync-codex.mjs",
    "codex:check": "node scripts/sync-codex.mjs --check",
    "opencode:sync": "node scripts/sync-codex.mjs --opencode",
    "opencode:check": "node scripts/sync-codex.mjs --opencode --check",
    "setup": "npm install --prefix scripts/framework-generator",
    "preflight": "node scripts/setup/preflight.mjs",
    "crawl:map": "node .claude/skills/app-explorer/lib/map.mjs",
    "crawl:deep": "node .claude/skills/app-explorer/lib/explore.mjs",
    "verify-auth": "tsx scripts/api-auth/verify-auth.ts",
    "record:ingest": "tsx scripts/analysis/ingest-recording.ts",
    "compile": "tsx scripts/model-compiler/compile-model.ts",
    "check": "tsx scripts/model-compiler/check-model.ts",
    "generate": "tsx scripts/framework-generator/emit/emit.ts",
    "draft": "tsx scripts/framework-generator/emit/draft.ts",
    "app:worktree": "node scripts/worktree/new-app.mjs",
    "pipeline:test": "tsx --test scripts/config/*.test.mjs .claude/skills/app-explorer/lib/*.test.mjs scripts/model-compiler/__tests__/*.test.ts scripts/analysis/__tests__/*.test.ts scripts/framework-generator/__tests__/*.test.ts scripts/api-auth/__tests__/*.test.ts",
    "pipeline:typecheck": "npm run typecheck --prefix scripts/framework-generator",
    "hooks:test": "node .claude/hooks/__fixtures__/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "rulesync": "16.31.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
