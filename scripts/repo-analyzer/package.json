{
  "name": "repo-analyzer",
  "version": "1.0.0",
  "description": "Static analysis of a local application repo. Detects the frontend and backend frameworks, then writes the component, route, URL and API reference files under analysis/.",
  "type": "module",
  "scripts": {
    "analyze": "cd ../.. && tsx scripts/repo-analyzer/analyze.ts",
    "detect": "cd ../.. && tsx scripts/repo-analyzer/detect.ts",
    "test": "tsx --test __tests__/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsx --test __tests__/unit.test.ts",
    "test:analyzers": "tsx --test __tests__/analyzers.test.ts",
    "fixtures": "tsx __fixtures__/run.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@vue/compiler-sfc": "^3.4.0",
    "js-yaml": "^4.1.0",
    "svelte": "^4.2.0"
  },
  "optionalDependencies": {
    "@angular/compiler": "^17.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
