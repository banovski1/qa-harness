{
  "name": "framework-generator",
  "version": "1.0.0",
  "description": "Static analysis in, Playwright test framework out. Reads analysis/ and generates a component-object-model framework in a configurable language.",
  "type": "module",
  "bin": {
    "framework-generator": "generate.mjs"
  },
  "scripts": {
    "generate": "cd ../.. && tsx scripts/framework-generator/generate.mjs",
    "check-analysis": "cd ../.. && tsx scripts/framework-generator/check-analysis.mjs",
    "test": "tsx --test __tests__/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
