{
  "name": "framework-generator",
  "version": "1.0.0",
  "description": "app-model.json in, a Playwright project out. Knows nothing about any application.",
  "type": "module",
  "bin": {
    "framework-generator": "bin.js"
  },
  "scripts": {
    "compile": "cd ../.. && tsx scripts/model-compiler/compile-model.ts",
    "check": "cd ../.. && tsx scripts/model-compiler/check-model.ts",
    "generate": "cd ../.. && tsx scripts/framework-generator/emit/emit.ts",
    "generate:dry": "cd ../.. && tsx scripts/framework-generator/emit/emit.ts --dry-run",
    "test": "cd ../.. && tsx --test scripts/model-compiler/__tests__/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
