{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmployeeTrackerListResponse",
  "type": "object",
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "employee"],
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "employee": {
            "type": "object",
            "required": ["empNumber"],
            "properties": {
              "empNumber": { "type": "integer" },
              "lastName":  { "type": "string" },
              "firstName": { "type": "string" }
            }
          },
          "addedDate":    { "type": ["number", "string", "null"] },
          "modifiedDate": { "type": ["number", "string", "null"] }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["total"],
      "properties": {
        "total": { "type": "integer" }
      }
    }
  }
}
